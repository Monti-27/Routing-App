---
const providers = [
  { name: 'OpenAI', logo: '/providers/openrouter.png' },
  { name: 'Anthropic', logo: '/model-logos/route-deepseek.png' },
  { name: 'Google', logo: '/model-logos/route-google.png' },
  { name: 'Meta', logo: '/model-logos/route-meta.png' },
  { name: 'Mistral', logo: '/providers/minimax.png' },
  { name: 'DeepSeek', logo: '/model-logos/route-deepseek.png' },
  { name: 'OpenRouter', logo: '/providers/openrouter.png' },
  { name: 'Minimax', logo: '/providers/minimax.png' },
];
---

<section class="relative pt-20 pb-32 overflow-hidden">
  <div class="absolute inset-0 z-0 bg-black">
    <img 
      src="/hero_background.PNG" 
      alt="" 
      class="w-full h-full object-cover opacity-20 blur-md"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/60 to-black"></div>
  </div>
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary text-secondary-foreground text-sm mb-8">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-500 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
        </span>
        100% Open Source - Cooked by Top Engineers
      </div>
      
      <h1 class="text-4xl sm:text-5xl lg:text-7xl font-display font-bold tracking-tight mb-6">
        <span class="bg-gradient-to-r from-green-400 via-emerald-400 to-green-500 bg-clip-text text-transparent">
          #1 No Log AI Provider
        </span>
        <br />
        <span class="text-primary">100% Open Source</span>
        <br />
        <span class="bg-gradient-to-r from-primary via-purple-500 to-primary bg-clip-text text-transparent">
          Look at the source, bro
        </span>
      </h1>
      
      <p class="text-lg sm:text-xl text-muted-foreground max-w-2xl mx-auto mb-10">
        Routing.run is a first-class AI routing service that's completely open source. 
        Built for developers who want transparency, control, and the best AI routing experience.
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
        <a
          href="https://github.com/anomalyco/routing.run"
          target="_blank"
          class="group relative inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 bg-green-600 hover:bg-green-700 text-white shadow h-12 px-8 text-base"
        >
          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          <span class="relative">View Source Code</span>
        </a>
        <a
          href="https://app.routing.run"
          class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-border bg-background hover:bg-secondary h-12 px-8"
        >
          Get Your API Key
        </a>
      </div>
      
      <div class="flex flex-wrap items-center justify-center gap-6 text-sm text-muted-foreground mb-16">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          100% Open Source
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          No vendor lock-in
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          30+ Models supported
        </div>
      </div>
      
      <div class="relative">
        <div class="absolute inset-0 gradient-blur opacity-50"></div>
        <div class="relative rounded-xl border border-border bg-card/50 backdrop-blur-sm p-2 shadow-2xl">
          <img
            src="/dashboard_photo_hero.png"
            alt="Dashboard Preview"
            class="w-full rounded-lg"
          />
        </div>
      </div>
    </div>
  </div>
</section>
