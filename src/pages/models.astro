---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ModelsSection from '../components/ui/models-section';
import Footer from '../components/Footer.astro';
---

<Layout title="Models - routing.run">
  <div class="relative min-h-screen">
    <div class="fixed inset-0 z-0 bg-gradient-to-b from-background via-background/95 to-background"></div>
    <div class="relative z-10">
      <Navbar />
      <main>
        <ModelsSection client:load />
      </main>
      <Footer />
    </div>
  </div>
</Layout>