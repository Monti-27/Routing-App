---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import FeaturesWrapper from '../components/FeaturesWrapper';
import LogoCloudWrapper from '../components/LogoCloudWrapper';
import Footer from '../components/Footer.astro';
---

<Layout title="routing.run - One API for every LLM">
  <div class="relative min-h-screen">
    <div class="fixed inset-0 z-0 bg-gradient-to-b from-background via-background/95 to-background"></div>
    <div class="relative z-10">
      <Navbar />
      <main>
        <Hero />
        <FeaturesWrapper client:visible />
        <LogoCloudWrapper />
      </main>
      <Footer />
    </div>
  </div>
</Layout>
